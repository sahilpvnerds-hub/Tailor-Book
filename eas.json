{
  "cli": {
    "version": ">= 3.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "preBuild": {
      "scripts": {
        "preBuild": "node scripts/postinstall-patch-expo.js"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_WORKINGDIR": "artifacts/mobile",
        "EXPO_PUBLIC_API_URL": "https://api-tailorbook.yiion.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_WORKINGDIR": "artifacts/mobile",
        "EXPO_PUBLIC_API_URL": "https://api-tailorbook.yiion.com"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_WORKINGDIR": "artifacts/mobile",
        "EXPO_PUBLIC_API_URL": "https://api-tailorbook.yiion.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
