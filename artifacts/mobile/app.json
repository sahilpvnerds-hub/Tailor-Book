{
  "expo": {
    "name": "Stitchix",
    "slug": "stitchix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stitchix",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "router": {
        "origin": "https://admin-tailorbook.yiion.com"
      },
      "eas": {
        "projectId": "217be2f4-0309-4b59-bdee-ba531bda1a3e"
      }
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1C7D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stitchix.app"
    },
    "android": {
      "package": "com.stitchix.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1C1C7D"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://admin-tailorbook.yiion.com"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "extraGradleArgs": [
              "-Dorg.gradle.jvmargs=-Xmx2048m -XX:MaxMetaspaceSize=512m"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "yiionsystems"
  }
}
